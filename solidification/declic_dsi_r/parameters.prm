subsection Rectangular mesh
  set x size = 614.4
  set y size = 3686.4
  set x subdivisions = 1
  set y subdivisions = 6
end

set global refinement = 8
set max refinement = 9
set min refinement = 4
set mesh adaptivity = true
set remeshing period = 150

subsection refinement criterion: 0
  set variables                      = phi
  set type                           = value
  set value lower bound              = -0.9999
  set value upper bound              = 0.9999
end

set time step = 0.0008
set number steps = 17225

subsection output
  set condition = EQUAL_SPACING
  set number = 1
end
